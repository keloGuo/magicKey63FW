
;设置键盘扫描的行IO
.program keyboardScanPinSet //这里可以多2个dma只需要一条指令就可以了
.side_set 5
.wrap_target                        ;扫描矩阵键盘，并和旧数据交错输出 
    wait 1 irq 1   side 0x01        ;等待中断1变0
    wait 1 irq 1   side 0x02        ;等待中断1变0
    wait 1 irq 1   side 0x04        ;等待中断1变0
    wait 1 irq 1   side 0x08        ;等待中断1变0 
    wait 1 irq 1   side 0x10        ;等待中断1变0 

    wait 1 irq 1   side 0x00        ;等待中断1变0
    wait 1 irq 1   side 0x00        ;等待中断1变0 
    wait 1 irq 1   side 0x00        ;等待中断1变0        
.wrap    
;读取列，输入：上次生效值，上次扫描值   输出：上次生效值，旧扫描值，新是扫描值
.program keyboardScan
.wrap_target            ;扫描矩阵键盘，并和旧数据交错输出
    set x, 15           ;循环16次  
    in pins,14          ;读进来14位
    irq 1               ;中断1  
    mov y, isr
    in null 32
loopStart:    
    mov osr,y           ;
    out isr,1           ;
    push                ;新扫描值
    mov y,osr
    pull 
    out isr ,1          ;in osr,8
    push                ;旧扫描值
    pull 
    out isr ,1          ;in osr,  8
    push                ;上次生效值
    jmp x--,loopStart
.wrap           
   

;输入：新扫描值，旧扫描值，上次生效数据
;输出：新扫描值，新生效值
.program xor            
xor:
    in  osr,  1         ;放旧的生效值出去
    out null, 8
.wrap_target            ;这里是程序启动的地方
    out x,8             ;新的扫描值
    out y,8             ;上次烧苗值
    in x, 1             ;先放一位新扫描值出去，
    jmp x!=y xor        ;不同就输出放旧的生效值出去            
    in x , 1            ;相同就放新的扫描值出去，当新的生效值
    out null, 8
.wrap           

;输入：新扫描值，新生效值
;输出：新的扫描值，新的生效值，压缩后的新生效值
.program DataSeparation    
.wrap_target   
    set x,15
    set y,0
 start:
    pull                ;取一个字节，新的扫描数据
    in  osr,  8         ;

    pull                ;取一个字节，新的生效数据
    in  osr,  8         

    mov isr, y          ;Y里面备份的压缩值发复制出来
    in  osr,  1         ;加一位
    mov y,isr           ;复制的到Y里面

    jmp x--,start      
    push
.wrap    

;输入16位数据，取出2个2位的编码器数据
;输出两个4位的编码器两次扫描的数据 
.program encoderA  
.wrap_target   
    pull
    out null,5   ;最开始的x位不要
    mov isr,x    ;x放到isr，上次数据   
    in  osr,2    ;放两位到isr，
    mov x,isr    ;备份起来，   
    push         ;push出去

    out null,3   ;中间y位不需要
    mov isr,y    
    in osr,2
    mov y,isr
    push 
.wrap       

;输入4位的编码器两次扫描数据
;输出结果
.program encoderB 
out1:
    set x,0x2
    jmp x!=y,over
    set x,0
    jmp over
.wrap_target      
    set x,0x1
    out y,4
    jmp x!=y,out1
over:    
    in x,2
.wrap       
